{
  "schema_version": 2,
  "name": "song_slides_v2",
  "label": "Song Slides (v2)",
  "description": "Freeform single container: uppercase centered lyrics with a black outline, title hidden. Content inset lives on body.padding; the text block animates independently.",
  "author": "RhemaCast",
  "kind": "freeform",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "background": "transparent",
    "fit": "contain"
  },
  "containers": [
    {
      "id": "main",
      "label": "Lyrics",
      "kind": "freeform",
      "layer": 10,
      "visible": true,
      "position": { "anchor": "fill" },
      "background": "transparent",
      "border": "none",
      "border_radius": 0,
      "box_shadow": "none",
      "backdrop_filter": "none",
      "opacity": 1.0,
      "overflow": "hidden",
      "blocks": {
        "body": {
          "visible": true,
          "valign": "center",
          "gap": 0,
          "padding": 0,
          "padding_top": 64,
          "padding_right": 96,
          "padding_bottom": 64,
          "padding_left": 96
        },
        "text": {
          "visible": true,
          "autosize": true,
          "color": "#ffffff",
          "font_family": "'Nunito', sans-serif",
          "size": 62,
          "min_size": 40,
          "max_size": 62,
          "weight": 800,
          "line_height": 1.08,
          "letter_spacing": "0.02em",
          "text_shadow": "none",
          "text_outline": "6px #000000",
          "text_transform": "uppercase",
          "text_align": "center",
          "margin_top": 0,
          "margin_right": 0,
          "margin_bottom": 0,
          "margin_left": 0,
          "padding": 0,
          "animation": {
            "entry": "verse_rise",
            "out": "gentle_out"
          }
        }
      }
    }
  ],
  "slide": {
    "show_title": false
  }
}
