{
    "name": "reference",
    "label": "Reference",
    "description": "Fixed 1920x420 centered reference display with transparent background and premium serif typography",
    "author": "RhemaCast",
    "container": {
        "background": "transparent",
        "border": "none",
        "border_radius": "0",
        "box_shadow": "none",
        "backdrop_filter": "none",
        "padding": "0",
        "max_width": "1840px",
        "min_width": "1840px",
        "width": "1840px",
        "height": "500px",
        "display": "flex",
        "flex_direction": "column",
        "justify_content": "center",
        "align_items": "center"
    },
    "body": {
        "vertical_align": "center",
        "padding_bottom": "0"
    },
    "text": {
        "color": "#ffffff",
        "font_family": "'Cormorant Garamond', serif",
        "size": "55px",
        "min_size": "50px",
        "max_size": "65px",
        "weight": 600,
        "line_height": "1.25",
        "text_shadow": "-2px -2px 0 #555, 2px -2px 0 #555, -2px 2px 0 #555, 2px 2px 0 #555, -2px 0 0 #555, 2px 0 0 #555, 0 -2px 0 #555, 0 2px 0 #555, 0 2px 20px rgba(0, 0, 0, 0.3)",
        "letter_spacing": "-0.005em",
        "margin_bottom": "16px"
    },
    "reference": {
        "color": "#b0b0b0",
        "font_family": "'DM Sans', sans-serif",
        "size": "36px",
        "weight": 500,
        "text_transform": "uppercase",
        "letter_spacing": "0.12em"
    },
    "translation": {
        "color": "#808080",
        "margin_left": "10px"
    }
