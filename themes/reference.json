{
    "name": "reference",
    "label": "Reference",
    "description": "Fixed 1920x420 centered reference display with transparent background and auto-resizing text",
    "author": "RhemaCast",
    "container": {
        "background": "transparent",
        "border": "none",
        "border_radius": "0",
        "box_shadow": "none",
        "backdrop_filter": "none",
        "padding": "0",
        "max_width": "1920px",
        "min_width": "1920px",
        "width": "1920px",
        "height": "640px",
        "display": "flex",
        "flex_direction": "column",
        "justify_content": "center",
        "align_items": "center"
    },
    "body": {
        "vertical_align": "center",
        "padding_bottom": "0"
    },
    "text": {
        "color": "#ffffff",
        "size": "55px",
        "min_size": "50px",
        "max_size": "65px",
        "weight": 700,
        "line_height": "1.2",
        "text_shadow": "none",
        "letter_spacing": "-0.01em",
        "margin_bottom": "12px"
    },
    "reference": {
        "color": "#cccccc",
        "size": "40px",
        "weight": 500,
        "text_transform": "uppercase",
        "letter_spacing": "0.1em"
    },
    "translation": {
        "color": "#999999",
        "margin_left": "8px"
    }
}