{
  "name": "fullscreen_2",
  "label": "Shadowed Full Screen",
  "description": "Full 1920x1080 screen display with auto-resizing text (40-55px) and verse number",
  "author": "RhemaCast",
  "containers": [
    {
      "id": "main",
      "layer": 0,
      "visible": true,
      "position": {
        "anchor": "top_left",
        "x": 60.0,
        "y": 0.0
      },
      "background": "transparent",
      "border": "none",
      "border_radius": "0",
      "box_shadow": "none",
      "backdrop_filter": "none",
      "width": "1800px",
      "height": "1080px",
      "min_width": "1800px",
      "max_width": "1800px",
      "min_height": 0,
      "max_height": null,
      "blocks": {
        "text": {
          "color": "#ffffff",
          "font_family": "'Nunito', sans-serif",
          "size": "46px",
          "min_size": "40px",
          "max_size": "60px",
          "weight": 700,
          "line_height": "1.08",
          "text_shadow": "-2px -2px 0 #555, 2px -2px 0 #555, -2px 2px 0 #555, 2px 2px 0 #555, -2px 0 0 #555, 2px 0 0 #555, 0 -2px 0 #555, 0 2px 0 #555, 0 2px 16px rgba(0, 0, 0, 0.6)",
          "text_transform": "none",
          "text_align": "center",
          "letter_spacing": "-0.02em",
          "margin_bottom": "20px",
          "autosize": true
        },
        "reference": {
          "color": "#cccccc",
          "size": "38px",
          "weight": 500,
          "text_transform": "uppercase",
          "letter_spacing": "0.1em",
          "position": "below_verse",
          "text_align": "center"
        },
        "translation": {
          "color": "#999999",
          "margin_left": "8px",
          "position": "right_of_reference",
          "size": "38px",
          "weight": 500,
          "letter_spacing": "0.1em",
          "text_transform": "uppercase",
          "text_align": "center"
        },
        "verse_num": {
          "mode": "inline",
          "size": "0.6em",
          "weight": 700,
          "opacity": 0.7,
          "vertical_align": "top",
          "margin_right": "0.15em",
          "line_height": 1,
          "color": "#cccccc",
          "font_family": "'Nunito', sans-serif",
          "text_align": "center"
        },
        "body": {
          "valign": "center",
          "padding": 0.0
        }
      }
    }
  ],
  "schema_version": 2,
  "kind": "scripture",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "background": "transparent",
    "fit": "none"
  }
}
