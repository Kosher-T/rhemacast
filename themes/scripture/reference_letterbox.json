{
  "schema_version": 2,
  "name": "reference_letterbox",
  "label": "Projection Reference — Letterbox",
  "description": "Wide projection band with gold letterbox rules, a zoom-settle verse and staged citation fades.",
  "author": "RhemaCast",
  "kind": "scripture",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "background": "transparent",
    "fit": "none"
  },
  "animations": {
    "letterbox_settle": {
      "type": "custom",
      "label": "Letterbox settle",
      "duration_ms": 1200,
      "delay_ms": 0,
      "easing": "ease-out",
      "origin": "center",
      "keyframes": [
        { "at": 0, "opacity": 0, "scale": 1.07, "blur": 7 },
        { "at": 58, "opacity": 1, "scale": 0.992, "blur": 0 },
        { "at": 100, "opacity": "base", "scale": 1, "blur": 0 }
      ]
    }
  },
  "containers": [
    {
      "id": "main",
      "layer": 0,
      "visible": true,
      "position": { "anchor": "top_left", "x": 0, "y": 330 },
      "background": "linear-gradient(180deg, rgba(2,6,23,0.92) 0%, rgba(9,16,38,0.78) 52%, rgba(2,6,23,0.92) 100%)",
      "border": {
        "width": 0,
        "style": "solid",
        "color": "transparent",
        "radius": 0,
        "sides": {
          "top": { "width": 3, "color": "@gold" },
          "bottom": { "width": 3, "color": "@gold" }
        }
      },
      "border_radius": 0,
      "box_shadow": "none",
      "backdrop_filter": "blur(6px)",
      "width": "1920px",
      "height": "540px",
      "min_width": "1920px",
      "max_width": "1920px",
      "min_height": 0,
      "max_height": null,
      "opacity": 1,
      "overflow": "hidden",
      "animation": {
        "entry": { "use": "slide_up", "duration_ms": 950 },
        "out": { "use": "slide_down", "duration_ms": 520 }
      },
      "blocks": {
        "body": {
          "visible": true,
          "valign": "center",
          "gap": 18,
          "padding": 48
        },
        "text": {
          "visible": true,
          "color": "@white",
          "font_family": "'Nunito', sans-serif",
          "size": "60px",
          "min_size": "42px",
          "max_size": "68px",
          "weight": 600,
          "line_height": "1.15",
          "letter_spacing": "-0.005em",
          "text_shadow": "0 10px 30px rgba(0, 0, 0, 0.65)",
          "text_align": "center",
          "autosize": true,
          "animation": {
            "entry": "letterbox_settle",
            "transition": { "out": "fade_out", "in": "letterbox_settle" },
            "out": "fade_out"
          }
        },
        "reference": {
          "visible": true,
          "color": "@gold",
          "font_family": "'DM Sans', sans-serif",
          "size": "36px",
          "weight": 700,
          "text_transform": "uppercase",
          "letter_spacing": "0.16em",
          "position": "below_verse",
          "text_align": "center",
          "animation": {
            "entry": { "use": "fade_up", "duration_ms": 700, "delay_ms": 260 },
            "out": { "use": "fade_out", "duration_ms": 420 }
          }
        },
        "translation": {
          "visible": true,
          "color": "@lime",
          "margin_left": "12px",
          "position": "right_of_reference",
          "font_family": "'DM Sans', sans-serif",
          "size": "30px",
          "weight": 500,
          "letter_spacing": "0.14em",
          "text_transform": "uppercase",
          "text_align": "center",
          "animation": {
            "entry": { "use": "fade_in", "duration_ms": 600, "delay_ms": 440 },
            "out": { "use": "fade_out", "duration_ms": 380 }
          }
        },
        "verse_num": {
          "visible": true,
          "mode": "inline",
          "size": "0.6em",
          "weight": 700,
          "opacity": 0.7,
          "vertical_align": "top",
          "margin_right": "0.15em",
          "line_height": 1,
          "color": "@gold",
          "font_family": "'Nunito', sans-serif",
          "text_align": "center"
        }
      }
    }
  ]
}
