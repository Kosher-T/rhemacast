{
  "schema_version": 2,
  "name": "fullscreen_pop",
  "label": "Fullscreen — Kinetic Pop",
  "description": "Fullscreen variant with springy scale/rotate pops on the text, a body fade and a container-scale transition.",
  "author": "RhemaCast",
  "kind": "scripture",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "background": "linear-gradient(135deg, #12081f 0%, #2a0b2e 55%, #451026 100%)",
    "fit": "none"
  },
  "animations": {
    "pop_in": {
      "type": "custom",
      "label": "Pop in",
      "duration_ms": 620,
      "delay_ms": 0,
      "easing": "spring",
      "origin": "center",
      "keyframes": [
        { "at": 0, "opacity": 0, "scale": 0.72, "rotate": -4, "blur": 6 },
        { "at": 60, "opacity": 1, "scale": 1.04, "rotate": 1, "blur": 0 },
        { "at": 100, "opacity": "base", "scale": 1, "rotate": 0, "blur": 0 }
      ]
    },
    "pop_out": {
      "type": "custom",
      "label": "Pop out",
      "duration_ms": 380,
      "delay_ms": 0,
      "easing": "ease-in",
      "origin": "center",
      "keyframes": [
        { "at": 0, "opacity": "base", "scale": 1, "rotate": 0, "blur": 0 },
        { "at": 100, "opacity": 0, "scale": 0.78, "rotate": 3, "blur": 4 }
      ]
    }
  },
  "containers": [
    {
      "id": "main",
      "label": "Pop panel",
      "layer": 10,
      "visible": true,
      "position": { "anchor": "center" },
      "width": "1740px",
      "height": "auto",
      "min_height": "880px",
      "max_width": "1740px",
      "background": "rgba(20, 8, 40, 0.55)",
      "border": { "shared": "gold_frame_heavy" },
      "border_radius": 34,
      "box_shadow": { "shared": "soft" },
      "backdrop_filter": "blur(20px) saturate(1.3)",
      "opacity": 1,
      "overflow": "hidden",
      "animation": {
        "entry": { "use": "scale_up", "duration_ms": 800 },
        "transition": {
          "out": { "use": "scale_down", "duration_ms": 350, "easing": "ease-in" }
        },
        "out": { "use": "fade_out", "duration_ms": 300 }
      },
      "blocks": {
        "body": {
          "visible": true,
          "valign": "center",
          "gap": 18,
          "padding": 60,
          "animation": {
            "entry": { "use": "fade_in", "duration_ms": 700, "delay_ms": 90 }
          }
        },
        "text": {
          "visible": true,
          "color": "#ffffff",
          "font_family": "'Nunito', sans-serif",
          "size": 88,
          "min_size": 56,
          "max_size": 110,
          "weight": 800,
          "line_height": 1.06,
          "letter_spacing": "-0.025em",
          "text_shadow": "0 20px 60px rgba(0,0,0,0.6)",
          "text_align": "center",
          "autosize": true,
          "animation": {
            "entry": "pop_in",
            "transition": { "out": "pop_out", "in": "pop_in" },
            "out": "pop_out"
          }
        },
        "reference": {
          "visible": true,
          "color": "@gold",
          "font_family": "'Nunito', sans-serif",
          "size": 42,
          "weight": 800,
          "text_transform": "uppercase",
          "letter_spacing": "0.12em",
          "position": "below_verse",
          "text_align": "center",
          "animation": {
            "entry": { "use": "pop_in", "duration_ms": 480, "delay_ms": 260 },
            "out": { "use": "fade_out", "duration_ms": 300 }
          }
        },
        "translation": {
          "visible": true,
          "color": "@lime",
          "font_family": "'Nunito', sans-serif",
          "size": 30,
          "weight": 700,
          "text_transform": "uppercase",
          "letter_spacing": "0.12em",
          "position": "right_of_reference",
          "margin_left": 12,
          "text_align": "center",
          "animation": {
            "entry": { "use": "fade_in", "duration_ms": 450, "delay_ms": 420 },
            "out": { "use": "fade_out", "duration_ms": 300 }
          }
        },
        "verse_num": {
          "visible": true,
          "mode": "inline",
          "size": "0.6em",
          "weight": 800,
          "opacity": 0.7,
          "vertical_align": "top",
          "margin_right": "0.15em",
          "line_height": 1,
          "color": "@gold",
          "font_family": "'Nunito', sans-serif",
          "text_align": "center"
        }
      }
    }
  ]
}
