# RhemaCast .gitignore — source-first: everything is tracked EXCEPT
# secrets, databases, and heavy/generated artifacts (see sections below).
# Working from another machine (e.g. phone): clone, create venv, copy
# .env.example -> .env, and rebuild the Bible DB/indexes locally.

# --- Secrets — NEVER commit (live API keys) ---
.env
.env.*
!.env.example

# --- Application Configuration & State (regenerates; may hold keys) ---
config.json

# --- Operator Schedules (live service plans; personal working data) ---
/data/schedules/

# --- Database & SQLite Temporary Files (local state, rebuildable) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/data/app.db*
/data/bible/*.db*

# --- Bible pipeline inputs/outputs (heavy + regenerated by convert.sh) ---
# NOTE: translations other than KJV are copyrighted — never commit their texts.
/data/bible/sources/
/data/bible/json/
/data/indexes/

# --- Audio Recordings & Media (heavy, personal) ---
*.wav
*.pcm
*.flac
*.mp3
*.ogg
*.m4a
*.aac
/data/recordings/

# --- Models & ML Weights (heavy, downloaded) ---
/models/
/data/vosk-model-small-en-us/

# --- Logs (noise) ---
*.log
debug.log
logs/
/var/lib/rhemacast/logs/

# --- Python & Testing Artifacts (regenerate on every run) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments (gigabytes, rebuild via pip install -r) ---
venv/
.venv/
env/
ENV/

# --- IDEs, OS & Local Tooling Files (personal/machine-specific) ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
opencode.json
.opencode/

# --- Mobile file back-and-forths (do not want to use Github)
mobile_version/

# --- Temp Harness
ocv/

# --- TRACKED BELOW (commented out): project sources, docs, tests, user decks ---
# tests/
# /docs/
# data/slides/
# AGENTS.md
# checklist_audit.md
# /temp/
# /local/
# /ui_draft/
# /windows/
